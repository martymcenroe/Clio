{
  "name": "clio",
  "version": "1.6.2",
  "description": "Extract full Gemini, Claude, and ChatGPT conversations to JSON with images",
  "main": "extensions/src/background.js",
  "private": true,
  "scripts": {
    "build:viewer": "node viewer/build.js",
    "prebuild": "npm run build:viewer",
    "test": "jest --testPathIgnorePatterns=e2e",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch --testPathIgnorePatterns=e2e",
    "test:e2e": "npm run build:viewer && playwright test",
    "test:e2e:headed": "npm run build:viewer && playwright test --headed",
    "test:e2e:dom-discovery": "npm run build:viewer && playwright test dom-discovery --debug",
    "test:e2e:notebook-recon": "playwright test notebook-recon --project=chromium --debug",
    "test:all": "npm run build:viewer && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "keywords": [
    "chrome-extension",
    "gemini",
    "conversation",
    "export",
    "json"
  ],
  "author": "",
  "license": "MIT"
}
